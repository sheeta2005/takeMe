<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="小区助老业务压测" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="已登录居民混合业务">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,60)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,30)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,600)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="合成账号池">
          <stringProp name="filename">${__P(accounts)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="ignoreFirstLine">false</boolProp>
        </CSVDataSet>
        <hashTree/>
        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="隔离服务地址">
          <intProp name="HTTPSampler.connect_timeout">3000</intProp>
          <intProp name="HTTPSampler.response_timeout">10000</intProp>
          <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
          <stringProp name="HTTPSampler.port">9081</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
        </ConfigTestElement>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="鉴权与 JSON">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Authorization" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${token}</stringProp>
            </elementProp>
            <elementProp name="Content-Type" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="所有线程共享目标吞吐" enabled="true">
          <stringProp name="throughput">${__P(tpm,1800)}</stringProp>
          <intProp name="calcMode">4</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="业务状态及订单关联校验">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
try {
    def result = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (result.code != 200) throw new IllegalStateException(&quot;业务失败 code=${result.code}, msg=${result.msg}&quot;)
    if (prev.getSampleLabel() == &apos;创建订单&apos;) {
        if (!result.data?.id) throw new IllegalStateException(&apos;建单未返回主键&apos;)
        vars.put(&apos;newOrderId&apos;, result.data.id.toString())
    } else if (prev.getSampleLabel() == &apos;重复提交校验&apos;) {
        if (result.data.id.toString() != vars.get(&apos;newOrderId&apos;)) throw new IllegalStateException(&apos;重试生成了不同订单&apos;)
    } else if (prev.getSampleLabel() == &apos;取消后状态校验&apos;) {
        if (result.data.status != 5) throw new IllegalStateException(&apos;取消未完成&apos;)
    }
} catch (Exception error) {
    prev.setSuccessful(false)
    prev.setResponseMessage(error.message)
}
          </stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223PostProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="混合业务">
          <stringProp name="HTTPSampler.path">${path}</stringProp>
          <stringProp name="HTTPSampler.method">${method}</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${payload}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="居民浏览思考时间">
            <stringProp name="ConstantTimer.delay">${__P(think,500)}</stringProp>
            <stringProp name="RandomTimer.range">1000</stringProp>
          </UniformRandomTimer>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="选择有效业务操作">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
int choice = java.util.concurrent.ThreadLocalRandom.current().nextInt(100)
vars.put(&apos;method&apos;,&apos;GET&apos;); vars.put(&apos;payload&apos;,&apos;&apos;); vars.put(&apos;operation&apos;,&apos;read&apos;)
vars.put(&apos;token&apos;, vars.get(&apos;userToken&apos;)); vars.remove(&apos;newOrderId&apos;)
if (choice &lt; 30) {
    sampler.setName(&apos;服务目录&apos;)
    vars.put(&apos;path&apos;, &apos;/api/user/service/list?type=&apos; + (choice % 5))
} else if (choice &lt; 55) {
    sampler.setName(&apos;老人订单列表&apos;)
    vars.put(&apos;path&apos;, &apos;/api/user/order/list?pageNum=1&amp;pageSize=10&apos;)
} else if (choice &lt; 65) {
    sampler.setName(&apos;老人订单详情&apos;)
    vars.put(&apos;path&apos;, &apos;/api/user/order/detail?orderId=&apos; + vars.get(&apos;existingOrderId&apos;))
} else if (choice &lt; 80) {
    sampler.setName(&apos;老人消息列表&apos;)
    vars.put(&apos;path&apos;, &apos;/api/user/message/list?pageNum=1&amp;pageSize=10&apos;)
} else if (choice &lt; 90) {
    sampler.setName(&apos;志愿者可接服务&apos;)
    vars.put(&apos;token&apos;, vars.get(&apos;volunteerToken&apos;))
    vars.put(&apos;path&apos;, &apos;/api/volunteer/order/available?pageNum=1&amp;pageSize=10&apos;)
} else if (choice &lt; 95) {
    sampler.setName(&apos;管理员聚合看板&apos;)
    vars.put(&apos;token&apos;, vars.get(&apos;adminToken&apos;)); vars.put(&apos;path&apos;,&apos;/api/admin/dashboard&apos;)
} else {
    sampler.setName(&apos;创建订单&apos;)
    vars.put(&apos;method&apos;,&apos;POST&apos;); vars.put(&apos;operation&apos;,&apos;create&apos;); vars.put(&apos;path&apos;,&apos;/api/user/order/create&apos;)
    def booking = java.time.LocalDateTime.now().plusHours(3)
    def payload = [order:[requestId:UUID.randomUUID().toString()],items:[[serviceId:3,quantity:1,
        serviceDate:booking.toLocalDate().toString(),serviceTime:booking.format(java.time.format.DateTimeFormatter.ofPattern(&apos;HH:mm&apos;)),
        address:&apos;合成压测地址&apos;,remark:&apos;仅用于隔离测试&apos;]]]
    vars.put(&apos;payload&apos;, groovy.json.JsonOutput.toJson(payload))
}
            </stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="有效建单后的结算链路" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get(&apos;operation&apos;) == &apos;create&apos; &amp;&amp; vars.get(&apos;newOrderId&apos;) != null)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="重复提交校验" enabled="true">
            <stringProp name="HTTPSampler.path">/api/user/order/create</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${payload}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="模拟支付">
            <stringProp name="HTTPSampler.path">/api/user/payment/mock</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;orderId&quot;:${newOrderId}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="取消与模拟退款">
            <stringProp name="HTTPSampler.path">/api/user/order/cancel?orderId=${newOrderId}</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="取消后状态校验">
            <stringProp name="HTTPSampler.path">/api/user/order/detail?orderId=${newOrderId}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
