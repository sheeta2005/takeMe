<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
  <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="共享出口登录峰值" enabled="true">
    <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
  </TestPlan>
  <hashTree>
    <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="独立老人账号登录" enabled="true">
      <stringProp name="ThreadGroup.num_threads">${__P(threads,30)}</stringProp>
      <stringProp name="ThreadGroup.ramp_time">5</stringProp>
      <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
      <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
        <intProp name="LoopController.loops">10</intProp>
        <boolProp name="LoopController.continue_forever">false</boolProp>
      </elementProp>
    </ThreadGroup>
    <hashTree>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="独立账号" enabled="true">
        <stringProp name="filename">${__P(accounts)}</stringProp><stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames"/><stringProp name="delimiter">,</stringProp>
        <boolProp name="recycle">false</boolProp><boolProp name="stopThread">true</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet><hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="请求类型" enabled="true">
        <collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header">
          <stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp>
        </elementProp></collectionProp>
      </HeaderManager><hashTree/>
      <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="BCrypt12 真实登录" enabled="true">
        <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">9081</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/user/login</stringProp>
        <stringProp name="HTTPSampler.method">POST</stringProp><stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
        <boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
        <stringProp name="HTTPSampler.connect_timeout">3000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments">
          <elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp>
            <stringProp name="Argument.value">{"username":"load_user${userId}","password":"${__FileToString(${__P(loginPassword)},UTF-8,)}"}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp></elementProp>
      </HTTPSamplerProxy>
      <hashTree>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="登录业务断言" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
try {
    def result = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (result.code != 200 || !result.data?.token) throw new IllegalStateException("登录业务失败: ${result.code}")
} catch (Exception error) { prev.setSuccessful(false); prev.setResponseMessage(error.message) }
          ]]></stringProp>
        </JSR223PostProcessor><hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</hashTree>
</jmeterTestPlan>
